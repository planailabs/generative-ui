{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan.ai/generative-ui/schemas/surface.v1.schema.json",
  "title": "Surface manifest (frame.json)",
  "description": "The manifest an agent writes at artifacts/{agent}/{deck}/{surface}/v/{version}/frame.json. The path is the identity; agent/deck/surface/version are not repeated here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "alt_text"],
  "properties": {
    "schema_version": { "const": "generative-ui/surface.v1" },
    "title": { "type": "string", "minLength": 1 },
    "alt_text": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "description": "ISO-8601 timestamp." },
    "backflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nav": {
      "type": "array",
      "description": "Edges to other surfaces in the deck, by surface slug.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to"],
        "properties": {
          "to": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Free-form agent data — the only place unknown keys are allowed."
    }
  }
}
