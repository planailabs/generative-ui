{
  "$id": "https://plan.ai/generative-ui/schemas/deck.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "`deck.json` — optional deck wiring: a display name, the entry surface, and a prev/next `order`. Absent ⇒ a flat deck ordered by first-seen version time.",
  "properties": {
    "entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "DeckManifest",
  "type": "object"
}
