{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan.ai/generative-ui/schemas/event.v1.schema.json",
  "title": "Backflow event",
  "description": "Written by the server into artifacts/{agent}/{deck}/{surface}/events/{unix-ms}-{action}.json when a user interacts with a surface. Agents read these from the directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "surface", "received_at"],
  "properties": {
    "schema_version": { "const": "generative-ui/event.v1" },
    "action": { "type": "string", "minLength": 1 },
    "component": { "type": "string" },
    "value": { "description": "Arbitrary interaction payload." },
    "surface": { "type": "string", "description": "agent/deck/surface" },
    "version": { "type": "string", "description": "Version the interaction was produced against." },
    "received_at": { "type": "string", "description": "ISO-8601 timestamp." }
  }
}
