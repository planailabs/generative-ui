  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "A backflow event, written by the server into `{surface}/events/{unix-ms}-{action}.json`.",
  "properties": {
    "action": {
      "type": "string"
    },
    "component": {
      "type": [
        "string",
        "null"
      ]
    },
    "received_at": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "surface": {
